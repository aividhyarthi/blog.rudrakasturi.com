# Railway tells the app which port to use through $PORT; the nginx image fills it in at start-up.
server {
  listen ${PORT};
  listen [::]:${PORT};
  server_name _;

  root /usr/share/nginx/html;
  index index.html;
  absolute_redirect off;

  # Old WordPress addresses -> new addresses
  if ($redirect_to) { return 301 $redirect_to; }

  # Posts briefly lived under /blog/; send those addresses to the original root addresses.
  location ~ ^/blog/(?!page/|index\.html)([^/]+)/?$ { return 301 /$1/; }
  # WordPress feed address
  location ~ ^/feed/?$ { return 301 /rss.xml; }

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml application/xml text/plain;

  location = /healthz { access_log off; default_type text/plain; return 200 "ok"; }

  location /_astro/ { expires 1y; add_header Cache-Control "public, immutable"; }
  location /images/ { expires 30d; }
  location /wp-content/ { expires 30d; }

  location / { try_files $uri $uri/ =404; }
  error_page 404 /404.html;
}
