---
import PostCard from './PostCard.astro';
import type { Post } from '../lib/posts';
const { title, href, posts, label } = Astro.props as { title: string; href: string; posts: Post[]; label?: string };
---

<section class="rail">
  <div class="rail-head">
    <div>
      {label && <p class="label">{label}</p>}
      <h2>{title}</h2>
    </div>
    <div class="rail-nav">
      <a class="link-arrow" href={href}>See all &rarr;</a>
      <button type="button" class="rail-btn" data-dir="-1" aria-label="Scroll left">&larr;</button>
      <button type="button" class="rail-btn" data-dir="1" aria-label="Scroll right">&rarr;</button>
    </div>
  </div>
  <div class="rail-track">
    {posts.map((p) => <PostCard post={p} />)}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.rail').forEach((rail) => {
    const track = rail.querySelector<HTMLElement>('.rail-track');
    rail.querySelectorAll<HTMLButtonElement>('.rail-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const step = (track?.clientWidth ?? 600) * 0.85;
        track?.scrollBy({ left: Number(btn.dataset.dir) * step, behavior: 'smooth' });
      });
    });
  });
</script>
