---
import { getAllPosts, getSections, getTags, topicOf, formatDate } from '../lib/posts';
import { coverUrl } from '../lib/cover';
import Subscribe from './Subscribe.astro';
import { NEWSLETTER, START_HERE, TOOLS, APPRANKR_POSTS, utm } from '../config';

const { exclude = '' } = Astro.props as { exclude?: string };
const all = await getAllPosts();
const latest = all.filter((p) => p.slug !== exclude).slice(0, 5);
const must = START_HERE.map((s) => all.find((p) => p.slug === s)).filter((p) => p && p.slug !== exclude).slice(0, 5) as typeof all;
const topics = getSections(all);
const tags = getTags(all, 4).slice(0, 18);
const tool = TOOLS[0];
const appr = TOOLS.find((t) => t.name === 'AppRankr')!;
---

<aside class="sidebar">
  {NEWSLETTER.enabled && (
    <section class="box box-news">
      <Subscribe variant="box" />
    </section>
  )}

  <section class="box">
    <h3>Latest</h3>
    <ul class="mini">
      {latest.map((p) => (
        <li>
          <a href={`/${p.slug}/`} class="mini-thumb" tabindex="-1" aria-hidden="true"><img src={coverUrl(p)} alt="" loading="lazy" width="120" height="63" /></a>
          <div><a href={`/${p.slug}/`}>{p.data.title}</a><small>{topicOf(p).name} · {formatDate(p.data.date)}</small></div>
        </li>
      ))}
    </ul>
  </section>

  <section class="box">
    <h3>Must read</h3>
    <ol class="must">
      {must.map((p) => <li><a href={`/${p.slug}/`}>{p.data.title}</a></li>)}
    </ol>
  </section>

  <section class="box">
    <h3>Topics</h3>
    <div class="chips chips-tight">
      {topics.map((t) => <a href={`/category/${t.slug}/`}>{t.name} <small>{t.count}</small></a>)}
    </div>
  </section>

  <section class="box">
    <h3>Popular tags</h3>
    <div class="chips chips-tight">
      {tags.map((t) => <a href={`/tag/${t.slug}/`}>{t.name} <small>{t.count}</small></a>)}
    </div>
  </section>

  <section class="box">
    <h3>App store insights</h3>
    <ol class="must">
      {APPRANKR_POSTS.slice(0, 3).map((p) => <li><a href={utm(p.url, 'sidebar')} rel="noopener">{p.title}</a></li>)}
    </ol>
    <p style="margin-top:12px"><a class="link-arrow" href={utm(appr.url, 'sidebar')} rel="noopener">Try AppRankr &rarr;</a></p>
  </section>

  <section class="box box-tool">
    <p class="label">Free tool</p>
    <h3>{tool.name}</h3>
    <p>{tool.blurb}</p>
    <a class="btn" href={utm(tool.url, 'sidebar')} rel="noopener">Try it &rarr;</a>
  </section>
</aside>

