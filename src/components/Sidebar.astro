---
import { getAllPosts, getTopics, getTags, topicOf, formatDate } from '../lib/posts';
import { coverUrl } from '../lib/cover';
import { NEWSLETTER, START_HERE, SITE, TOOLS } from '../config';

const { exclude = '' } = Astro.props as { exclude?: string };
const all = await getAllPosts();
const latest = all.filter((p) => p.slug !== exclude).slice(0, 5);
const must = START_HERE.map((s) => all.find((p) => p.slug === s)).filter((p) => p && p.slug !== exclude).slice(0, 5) as typeof all;
const topics = getTopics(all).filter((t) => t.count >= 3);
const tags = getTags(all, 4).slice(0, 18);
const tool = TOOLS[0];
const viaEmail = !NEWSLETTER.action;
---

<aside class="sidebar">
  <section class="box box-news">
    <h3>{NEWSLETTER.title}</h3>
    <p>{NEWSLETTER.blurb}</p>
    {viaEmail ? (
      <form action={`mailto:${SITE.email}`} method="get" enctype="text/plain">
        <input type="hidden" name="subject" value="Subscribe me to the Search & AI brief" />
        <input type="email" name="body" placeholder="you@company.com" required aria-label="Your email" />
        <button class="btn btn-mint" type="submit">Subscribe</button>
      </form>
    ) : (
      <form action={NEWSLETTER.action} method="post" target="_blank">
        <input type="email" name={NEWSLETTER.emailField} placeholder="you@company.com" required aria-label="Your email" />
        <button class="btn btn-mint" type="submit">Subscribe</button>
      </form>
    )}
  </section>

  <section class="box">
    <h3>Latest</h3>
    <ul class="mini">
      {latest.map((p) => (
        <li>
          <a href={`/blog/${p.slug}/`} class="mini-thumb" tabindex="-1" aria-hidden="true"><img src={coverUrl(p)} alt="" loading="lazy" width="120" height="63" /></a>
          <div><a href={`/blog/${p.slug}/`}>{p.data.title}</a><small>{topicOf(p).name} · {formatDate(p.data.date)}</small></div>
        </li>
      ))}
    </ul>
  </section>

  <section class="box">
    <h3>Must read</h3>
    <ol class="must">
      {must.map((p) => <li><a href={`/blog/${p.slug}/`}>{p.data.title}</a></li>)}
    </ol>
  </section>

  <section class="box">
    <h3>Topics</h3>
    <div class="chips chips-tight">
      {topics.map((t) => <a href={`/category/${t.slug}/`}>{t.name} <small>{t.count}</small></a>)}
    </div>
  </section>

  <section class="box">
    <h3>Popular tags</h3>
    <div class="chips chips-tight">
      {tags.map((t) => <a href={`/tag/${t.slug}/`}>{t.name} <small>{t.count}</small></a>)}
    </div>
  </section>

  <section class="box box-tool">
    <p class="label">Free tool</p>
    <h3>{tool.name}</h3>
    <p>{tool.blurb}</p>
    <a class="btn" href={tool.url} rel="noopener">Try it &rarr;</a>
  </section>
</aside>
