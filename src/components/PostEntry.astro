---
import { excerpt, readingTime, topicOf, topicColor, type Post } from '../lib/posts';
import { coverUrl } from '../lib/cover';
const { post } = Astro.props as { post: Post };
const topic = topicOf(post);
const label = { article: null, research: 'Research', 'case-study': 'Case study' }[post.data.type];
const when = post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

<article class={`entry ${topicColor(topic.slug)}`}>
  <div class="entry-body">
    <p class="entry-kicker">
      {label && <strong class="pill">{label}</strong>}
      <a href={`/category/${topic.slug}/`}>{topic.name}</a>
      <span>{when}</span>
    </p>
    <h3><a href={`/${post.slug}/`}>{post.data.title}</a></h3>
    <p class="entry-desc">{post.data.tldr ? excerpt({ data: { description: post.data.tldr } } as Post, 190) : excerpt(post, 190)}</p>
    <p class="entry-meta">{readingTime(post)} min read</p>
  </div>
  <a href={`/${post.slug}/`} class="entry-thumb" tabindex="-1" aria-hidden="true">
    <img src={coverUrl(post)} alt="" loading="lazy" width="1200" height="630" />
  </a>
</article>
