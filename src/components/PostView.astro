---
import { formatDate, readingTime, topicOf, tagsOf, type Post } from '../lib/posts';
import { coverUrl, coverPngUrl } from '../lib/cover';
import BaseLayout from '../layouts/BaseLayout.astro';
import Carousel from './Carousel.astro';
import ConsultingCTA from './ConsultingCTA.astro';
import Sidebar from './Sidebar.astro';
import AuditBanner from './AuditBanner.astro';
import Subscribe from './Subscribe.astro';
import NewsletterPopup from './NewsletterPopup.astro';
import Avatar from './Avatar.astro';
import { authorOf } from '../lib/authors';
import { SITE, NEWSLETTER } from '../config';

const { post, related } = Astro.props as { post: Post; related: Post[] };
const { Content } = await post.render();
const { title, description, date, updated, type, tldr, sources } = post.data;
const topic = topicOf(post);
const author = authorOf(post);
const label = { article: 'Article', research: 'Research', 'case-study': 'Case study' }[type];

// ---- schema.org Article ----
const origin = new URL(Astro.site!).origin;
const pageUrl = new URL(Astro.url.pathname, origin).href;
const modified = updated ?? date;
const article = {
  '@type': sources.length > 0 ? 'NewsArticle' : 'Article',
  '@id': `${pageUrl}#article`,
  url: pageUrl,
  isPartOf: { '@id': `${pageUrl}#webpage` },
  mainEntityOfPage: { '@id': `${pageUrl}#webpage` },
  headline: title.slice(0, 110),
  description: description || tldr || title,
  ...(tldr ? { abstract: tldr } : {}),
  image: [{ '@type': 'ImageObject', url: `${origin}${coverPngUrl(post)}`, width: 1200, height: 630 }],
  datePublished: date.toISOString(),
  dateModified: modified.toISOString(),
  author: { '@id': `${origin}/authors/${author.slug}/#person` },
  reviewedBy: { '@id': `${origin}/#organization` },
  publisher: { '@type': 'Organization', '@id': `${origin}/#organization`, name: 'Rudra Kasturi Inc.', logo: { '@type': 'ImageObject', url: `${origin}/logo.png`, width: 512, height: 512 } },
  articleSection: topic.name,
  keywords: [...new Set([topic.name, ...tagsOf(post).map((t) => t.name)])].slice(0, 8).join(', '),
  wordCount: post.body.split(/\s+/).filter(Boolean).length,
  timeRequired: `PT${readingTime(post)}M`,
  inLanguage: 'en',
  isAccessibleForFree: true,
  ...(sources.length
    ? { citation: sources.map((src) => ({ '@type': 'CreativeWork', name: src.title, url: src.url, publisher: { '@type': 'Organization', name: src.publisher } })) }
    : {}),
};
const crumbs = [
  { name: 'Home', url: '/' },
  { name: topic.name, url: `/category/${topic.slug}/` },
  { name: title, url: Astro.url.pathname },
];
---

<BaseLayout
  title={`${title} | Rudra Kasturi`}
  description={description || tldr || undefined}
  image={coverPngUrl(post)}
  ogType="article"
  published={date}
  modified={modified}
  section={topic.name}
  breadcrumbs={crumbs}
  jsonld={[article, {
    '@type': 'Person', '@id': `${origin}/authors/${author.slug}/#person`, name: author.name, jobTitle: author.role,
    url: `${origin}/authors/${author.slug}/`, image: `${origin}/authors/${author.slug}.png`, knowsAbout: author.knows,
    description: `${author.bio} ${author.name} is an AI author persona; content is reviewed and published by Rudra Kasturi.`,
    worksFor: { '@id': `${origin}/#organization` },
  }]}
  mainEntityId={`${pageUrl}#article`}
>
  <div class="wrap layout">
    <div class="article-main">
      <header class="article-head">
        <p class="label">{label} · <a href={`/category/${topic.slug}/`} style="text-decoration:none">{topic.name}</a></p>
        <h1>{title}</h1>
        <div class="byline-row">
          <Avatar author={author} size={44} />
          <p class="byline">
            By <a href={`/authors/${author.slug}/`}><b>{author.name}</b></a> · Reviewed by <b>Editorial Desk</b><br />
            {formatDate(date)} · {readingTime(post)} min read{updated && ` · Updated ${formatDate(updated)}`}
          </p>
        </div>
      </header>
      <div class="post-hero"><img src={coverUrl(post)} alt="" width="1200" height="630" /></div>
      {tldr && <div class="tldr"><b>SUMMARY</b><p>{tldr}</p></div>}
      <article class="prose"><Content /></article>

      {sources.length > 0 && (
        <section class="source-box" id="sources">
          <h2>Sources</h2>
          <ul>
            {sources.map((s) => <li><a href={s.url} rel="noopener">{s.title}</a> <span>· {s.publisher}</span></li>)}
          </ul>
        </section>
      )}

      {NEWSLETTER.enabled && <section class="subscribe-band"><Subscribe variant="inline" /></section>}

      <AuditBanner medium="article" />
      <ConsultingCTA />
    </div>
    <Sidebar exclude={post.slug} />
  </div>

  {NEWSLETTER.enabled && <NewsletterPopup />}

  {related.length > 0 && (
    <div class="wrap related">
      <Carousel title={`More on ${topic.name}`} href={`/category/${topic.slug}/`} posts={related} />
    </div>
  )}
</BaseLayout>
