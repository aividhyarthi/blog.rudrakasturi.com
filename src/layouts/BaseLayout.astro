---
import { SITE, COMPANIES, mailto } from '../config';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, image, description = 'Plain-English explainers on SEO, AEO and AI search, with every source linked. By Rudra Kasturi.' } = Astro.props;
const currentPath = Astro.url.pathname;
const nav = [
  { href: '/blog', label: 'Articles' },
  { href: '/category', label: 'Topics' },
  { href: '/research', label: 'Research' },
  { href: '/companies', label: 'Tools' },
  { href: '/about', label: 'About' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {image && <meta property="og:image" content={new URL(image, Astro.site).href} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title="Rudra Kasturi" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsenseClient}`} crossorigin="anonymous"></script>
  </head>
  <body>
    <header class="masthead">
      <div class="wrap masthead-in">
        <a href="/" class="brand">Rudra Kasturi <em>Inc.</em></a>
        <nav class="nav" aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} class:list={[{ active: currentPath.startsWith(n.href) }]}>{n.label}</a>
          ))}
          <a href="/work-with-me" class="nav-cta">Work with me</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer-grid">
        <div>
          <p class="brand brand-light">Rudra Kasturi <em>Inc.</em></p>
          <p class="footer-note">{SITE.tagline}</p>
          <p class="footer-note"><a href={mailto}>{SITE.email}</a><br /><a href={SITE.linkedin} rel="noopener">LinkedIn</a> · <a href="/rss.xml">RSS</a></p>
        </div>
        <div>
          <p class="label">Explore</p>
          <ul>
            <li><a href="/blog">All articles</a></li>
            <li><a href="/category/">Topics</a></li>
            <li><a href="/research">Research &amp; case studies</a></li>
            <li><a href="/about">About Rudra</a></li>
            <li><a href="/work-with-me">Work with me</a></li>
            <li><a href="/companies">Companies &amp; tools</a></li>
          </ul>
        </div>
        <div>
          <p class="label">Group companies</p>
          <ul>
            {COMPANIES.map((c) => <li><a href={c.url} rel="noopener">{c.name}</a></li>)}
          </ul>
        </div>
      </div>
      <div class="wrap footer-base">&copy; {new Date().getFullYear()} Rudra Kasturi. All rights reserved.</div>
    </footer>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
