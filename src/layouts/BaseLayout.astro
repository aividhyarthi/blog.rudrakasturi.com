---
import { SITE, COMPANIES, TOOLS, utm } from '../config';
import { SECTIONS } from '../lib/posts';

interface Crumb { name: string; url: string }
interface Props {
  title: string;
  description?: string;
  image?: string;
  // Structured data
  pageType?: 'WebPage' | 'CollectionPage' | 'AboutPage' | 'ContactPage' | 'ProfilePage';
  breadcrumbs?: Crumb[];
  jsonld?: Record<string, unknown>[];
  personExtra?: Record<string, unknown>;
  mainEntityId?: string;
  // Open Graph / indexing
  ogType?: 'website' | 'article';
  published?: Date;
  modified?: Date;
  section?: string;
  noindex?: boolean;
}

const {
  title, image, pageType = 'WebPage', breadcrumbs, jsonld = [], personExtra = {}, mainEntityId,
  ogType = 'website', published, modified, section, noindex = false,
  description = 'Clear, sourced analysis of SEO, AEO, AI search, YouTube and social. By Rudra Kasturi.',
} = Astro.props;
const currentPath = Astro.url.pathname;
const toolLinks = [
  { label: 'Your Website AEO Analyzer', href: '/your-website-aeo-analyzer/' },
  { label: 'E-Commerce Product Page AEO Analyser', href: '/product-page-aeo-analyser/' },
  { label: 'AI SEO GPT', href: '/ai-seo-gpt-by-rudra-kasturi/' },
  ...TOOLS.map((t) => ({ label: `${t.name} (${t.host})`, href: utm(t.url, 'menu'), external: true })),
  { label: 'All tools & companies', href: '/companies/' },
];
const onToolPage = toolLinks.some((l) => !l.external && currentPath.startsWith(l.href));

// ---- Structured data (schema.org JSON-LD) ----
const origin = new URL(Astro.site!).origin;
const abs = (u: string) => new URL(u, origin).href;
const pageUrl = abs(currentPath);
const orgId = `${origin}/#organization`;
const siteId = `${origin}/#website`;
const personId = `${origin}/#rudra`;
const crumbs: Crumb[] = breadcrumbs ?? (currentPath === '/' ? [{ name: 'Home', url: '/' }] : [{ name: 'Home', url: '/' }, { name: title.split('|')[0].trim(), url: currentPath }]);

const graph: Record<string, unknown>[] = [
  {
    '@type': 'Organization', '@id': orgId, name: 'Rudra Kasturi Inc.', url: `${origin}/`,
    logo: { '@type': 'ImageObject', '@id': `${origin}/#logo`, url: abs('/logo.png'), width: 512, height: 512 },
    image: abs('/logo.png'), sameAs: [SITE.linkedin], email: SITE.email, founder: { '@id': personId },
    slogan: SITE.tagline,
  },
  {
    '@type': 'WebSite', '@id': siteId, url: `${origin}/`, name: 'Rudra Kasturi',
    description: 'Clear, sourced analysis of SEO, AEO and AI search by Rudra Kasturi.',
    publisher: { '@id': orgId }, inLanguage: 'en',
  },
  {
    '@type': 'Person', '@id': personId, name: 'Rudra Kasturi', url: abs('/about/'), sameAs: [SITE.linkedin],
    email: SITE.email, worksFor: { '@id': orgId }, image: abs('/images/rudra-googleio.jpeg'),
    ...personExtra,
  },
  {
    '@type': pageType, '@id': `${pageUrl}#webpage`, url: pageUrl, name: title, description,
    isPartOf: { '@id': siteId }, about: { '@id': orgId }, inLanguage: 'en',
    breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
    ...(mainEntityId ? { mainEntity: { '@id': mainEntityId } } : {}),
    ...(image ? { primaryImageOfPage: { '@type': 'ImageObject', url: abs(image), width: 1200, height: 630 } } : {}),
    ...(published ? { datePublished: published.toISOString() } : {}),
    ...(modified ? { dateModified: modified.toISOString() } : {}),
  },
  {
    '@type': 'BreadcrumbList', '@id': `${pageUrl}#breadcrumb`,
    itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: abs(c.url) })),
  },
  ...jsonld,
];
const schema = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
const robots = noindex
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="robots" content={robots} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="Rudra Kasturi" />
    <meta property="og:locale" content="en_US" />
    {image && <meta property="og:image" content={abs(image)} />}
    {image && <meta property="og:image:width" content="1200" />}
    {image && <meta property="og:image:height" content="630" />}
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    {section && <meta property="article:section" content={section} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={abs(image)} />}
    <link rel="canonical" href={pageUrl} />
    <link rel="alternate" type="application/rss+xml" title="Rudra Kasturi" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={schema} />
    <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsenseClient}`} crossorigin="anonymous"></script>
  </head>
  <body>
    <header class="masthead">
      <div class="wrap masthead-in">
        <a href="/" class="brand">Rudra Kasturi <em>Inc.</em></a>
        <nav class="nav" aria-label="Main">
          {SECTIONS.map((sec) => (
            <a href={`/category/${sec.slug}/`} class:list={[{ active: currentPath.startsWith(`/category/${sec.slug}/`) }]}>{sec.name}</a>
          ))}
          <div class="nav-dd">
            <button type="button" class:list={['nav-dd-btn', { active: onToolPage }]} aria-expanded="false" aria-haspopup="true">Tools <span aria-hidden="true">&#9662;</span></button>
            <div class="nav-menu">
              {toolLinks.map((l) => <a href={l.href} rel={l.external ? 'noopener' : undefined}>{l.label}{l.external && ' ↗'}</a>)}
            </div>
          </div>
          <a href="/about/" class:list={[{ active: currentPath.startsWith('/about') }]}>About</a>
          <a href="/work-with-me/" class="nav-cta">Work with me</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer-grid">
        <div>
          <p class="brand brand-light">Rudra Kasturi <em>Inc.</em></p>
          <p class="footer-note">{SITE.tagline}</p>
          <p class="footer-note"><a href={`mailto:${SITE.email}`}>{SITE.email}</a><br /><a href={SITE.linkedin} rel="noopener">LinkedIn</a> · <a href="/rss.xml">RSS</a></p>
        </div>
        <div>
          <p class="label">Browse</p>
          <ul>
            {SECTIONS.map((sec) => <li><a href={`/category/${sec.slug}/`}>{sec.name}</a></li>)}
          </ul>
        </div>
        <div>
          <p class="label">Explore</p>
          <ul>
            <li><a href="/blog/">All articles</a></li>
            <li><a href="/about/">About Rudra</a></li>
            <li><a href="/work-with-me/">Work with me</a></li>
            <li><a href="/companies/">Tools &amp; companies</a></li>
            <li><a href="/authors/">Contributors</a></li>
            <li><a href="/contact/">Contact</a></li>
          </ul>
        </div>
        <div>
          <p class="label">Group companies</p>
          <ul>
            {COMPANIES.map((c) => <li><a href={c.url} rel="noopener">{c.name}</a></li>)}
          </ul>
        </div>
      </div>
      <div class="wrap footer-base">
        <span>&copy; {new Date().getFullYear()} Rudra Kasturi. All rights reserved.</span>
        <span><a href="/privacy-policy/">Privacy Policy</a> · <a href="/terms-of-service/">Terms of Service</a></span>
      </div>
    </footer>
    <script>
      // Tools dropdown: opens on click or tap, closes on outside click or Escape (hover also works with CSS).
      document.querySelectorAll<HTMLElement>('.nav-dd').forEach((dd) => {
        const btn = dd.querySelector<HTMLButtonElement>('.nav-dd-btn')!;
        const set = (open: boolean) => { dd.classList.toggle('open', open); btn.setAttribute('aria-expanded', String(open)); };
        btn.addEventListener('click', () => set(!dd.classList.contains('open')));
        document.addEventListener('click', (e) => { if (!dd.contains(e.target as Node)) set(false); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
      });
    </script>
    </footer>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
