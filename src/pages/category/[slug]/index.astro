---
import Listing from '../../../components/Listing.astro';
import { getAllPosts, getTopics, postsInTopic, pageOf, totalPages } from '../../../lib/posts';

export async function getStaticPaths() {
  const all = await getAllPosts();
  return getTopics(all).map((t) => {
    const posts = postsInTopic(all, t.slug);
    return { params: { slug: t.slug }, props: { topic: t, posts } };
  });
}
const { topic, posts } = Astro.props;
---

<Listing
  title={`${topic.name} | Rudra Kasturi`}
  description={`Articles on ${topic.name} by Rudra Kasturi.`}
  label="Topic"
  heading={topic.name}
  lede=""
  contributors={topic.slug}
  posts={pageOf(posts, 1)}
  current={1}
  total={totalPages(posts.length)}
  trail={[{ name: 'Topics', url: '/category/' }, { name: topic.name, url: `/category/${topic.slug}/` }]}
  totalCount={posts.length}
  base={`/category/${topic.slug}/`}
/>
