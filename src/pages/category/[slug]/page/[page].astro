---
import Listing from '../../../../components/Listing.astro';
import { getAllPosts, getTopics, postsInTopic, pageOf, totalPages } from '../../../../lib/posts';

export async function getStaticPaths() {
  const all = await getAllPosts();
  return getTopics(all).flatMap((t) => {
    const posts = postsInTopic(all, t.slug);
    const total = totalPages(posts.length);
    return Array.from({ length: total - 1 }, (_, i) => {
      const page = i + 2;
      return { params: { slug: t.slug, page: String(page) }, props: { topic: t, posts: pageOf(posts, page), page, total } };
    });
  });
}
const { topic, posts, page, total } = Astro.props;
---

<Listing
  title={`${topic.name}, page ${page} | Rudra Kasturi`}
  description={`Articles on ${topic.name} by Rudra Kasturi.`}
  label="Topic"
  heading={topic.name}
  lede=""
  contributors={topic.slug}
  posts={posts}
  current={page}
  total={total}
  trail={[{ name: 'Topics', url: '/category/' }, { name: topic.name, url: `/category/${topic.slug}/` }]}
  totalCount={topic.count}
  base={`/category/${topic.slug}/`}
/>
