---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllPosts, getTopics } from '../../lib/posts';

const topics = getTopics(await getAllPosts());
---

<BaseLayout title="Topics | Rudra Kasturi" description="Browse articles by topic.">
  <div class="wrap">
    <div class="page-head">
      <p class="label">Topics</p>
      <h1>Browse by topic</h1>
      <p class="lede">Everything on the blog, grouped by subject.</p>
    </div>
    <div class="topic-list">
      {topics.map((t) => (
        <a href={`/category/${t.slug}/`} class="topic-row"><span>{t.name}</span><small>{t.count} {t.count === 1 ? 'post' : 'posts'}</small></a>
      ))}
    </div>
    <div style="height: 72px"></div>
  </div>
</BaseLayout>
