---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, mailto } from '../config';

const whatsapp = 'https://wa.me/919266032660?text=' + encodeURIComponent('Hi, I would like to discuss my website or AI requirements.');
---

<BaseLayout
  title="Contact | Rudra Kasturi"
  description="Contact Rudra Kasturi by email, LinkedIn or WhatsApp."
  pageType="ContactPage"
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Contact', url: '/contact/' }]}
>
  <div class="wrap">
    <div class="page-head">
      <p class="label">Contact</p>
      <h1>Get in touch</h1>
      <p class="lede">For consulting, partnerships or speaking, choose whichever channel suits you.</p>
    </div>
    <div class="contact-grid">
      <div class="col"><h3>Email</h3><p>Best for detailed questions and project briefs.</p><a class="go" href={mailto}>{SITE.email} &rarr;</a></div>
      <div class="col"><h3>LinkedIn</h3><p>Connect or send a message.</p><a class="go" href={SITE.linkedin} rel="noopener">Rudra Kasturi on LinkedIn &rarr;</a></div>
      <div class="col"><h3>WhatsApp</h3><p>Share your website or AI requirements and we will get back to you.</p><a class="go" href={whatsapp} rel="noopener">Chat on WhatsApp &rarr;</a></div>
    </div>
  </div>
</BaseLayout>
