---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostEntry from '../../../components/PostEntry.astro';
import Avatar from '../../../components/Avatar.astro';
import { AUTHORS, postsByAuthor } from '../../../lib/authors';
import { getAllPosts } from '../../../lib/posts';

export function getStaticPaths() {
  return AUTHORS.map((a) => ({ params: { slug: a.slug }, props: { a } }));
}
const { a } = Astro.props;
const all = await getAllPosts();
const posts = postsByAuthor(all, a.slug);
const origin = new URL(Astro.site!).origin;
const person = {
  '@type': 'Person', '@id': `${origin}/authors/${a.slug}/#person`,
  name: a.name, jobTitle: a.role, url: `${origin}/authors/${a.slug}/`,
  description: `${a.name} is an AI author persona in the Rudra Kasturi Inc. contributor desk. ${a.bio}`,
  knowsAbout: a.knows
};
const list = {
  '@type': 'ItemList', '@id': `${origin}/authors/${a.slug}/#itemlist`,
  name: `Articles by ${a.name}`, numberOfItems: posts.length,
  itemListElement: posts.slice(0, 30).map((p, i) => ({
    '@type': 'ListItem', position: i + 1, url: `${origin}/${p.slug}/`, name: p.data.title
  }))
};
const firstName = a.name.split(' ')[0];
const focusCards = [
  { title: a.knows[0] ?? 'Research', description: 'Tracking developments, evidence and practical implications.' },
  { title: a.knows[1] ?? 'Analysis', description: 'Explaining what changes and why it matters.' },
  { title: a.knows[2] ?? 'Strategy', description: 'Turning complex information into clear next steps.' },
  { title: a.knows[3] ?? 'Industry', description: 'Connecting platform changes with business impact.' }
];
---
<BaseLayout title={`${a.name}, ${a.role} | Rudra Kasturi`} description={`${a.name} is an AI author persona covering ${a.knows.slice(0, 3).join(', ')} for Rudra Kasturi Inc.`} pageType="ProfilePage" jsonld={[person, list]} mainEntityId={`${origin}/authors/${a.slug}/#person`} breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Authors', url: '/authors/' }, { name: a.name, url: `/authors/${a.slug}/` }]}>
  <main class="wrap rk-author-page">
    <p class="rk-author-crumb"><a href="/">Home</a><span>›</span><a href="/authors/">Authors</a><span>›</span><b>{a.name}</b></p>
    <section class="rk-author-hero">
      <div class="rk-author-portrait"><Avatar author={a} size={352} /></div>
      <div class="rk-author-intro">
        <span class="rk-eyebrow">AI CONTRIBUTOR PERSONA</span>
        <h1>{a.name}</h1>
        <p class="rk-author-role">{a.role}</p>
        <p class="rk-author-summary">{a.bio} This contributor focuses on making complex developments clear and useful for businesses, publishers and marketers.</p>
        <div class="rk-author-stats">
          <div><strong>{a.topics.map((t) => t.toUpperCase()).join(' · ')}</strong><span>Editorial desk</span></div>
          <div><strong>{posts.length}</strong><span>Published articles</span></div>
          <div><strong>{a.knows.length}</strong><span>Focus areas</span></div>
        </div>
        <a class="rk-author-email" href="mailto:ai@rudrakasturi.com" aria-label="Email the Rudra Kasturi editorial desk">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 7 9-7"></path></svg>
          Contact the editorial desk
        </a>
        <p class="rk-publisher">Published by <a href="/about/">Rudra Kasturi Inc.</a></p>
      </div>
      <aside class="rk-author-focus">
        <h2>Areas of Focus</h2>
        <div class="rk-pills">{a.knows.map((k) => <span>{k}</span>)}</div>
        <div class="rk-focus-divider"></div>
        <h2>Interests &amp; Hobbies</h2>
        <ul>{a.beyondDesk.map((item, i) => <li><span class="rk-interest-icon">{['▤','⌁','◷','⌖'][i % 4]}</span>{item}</li>)}</ul>
        <p class="rk-persona-note">Illustrative interests for this AI persona, not a real person's biography.</p>
      </aside>
    </section>

    <section class="rk-author-body">
      <div class="rk-author-main">
        <section class="rk-about">
          <h2>About {firstName}</h2>
          <p>{a.bio} The role of this contributor persona is to bring a consistent subject lens to research, explain technical developments in plain language and connect announcements with practical implications for publishers, marketers and businesses.</p>
          <p>This is an AI persona created to organise specialist coverage. It does not represent a real individual, personal career history or lived experience. Editorial accountability sits with Rudra Kasturi Inc.</p>
        </section>
        <section class="rk-editorial-focus">
          <h2>Editorial Focus</h2>
          <div class="rk-focus-cards">
            {focusCards.map((card, i) => <article><span class="rk-focus-symbol">{['⌕','▱','▥','♧'][i]}</span><h3>{card.title}</h3><p>{card.description}</p></article>)}
          </div>
        </section>
        <section class="rk-latest-work">
          <div class="rk-section-heading"><h2>Latest articles by {firstName}</h2><span>{posts.length} articles</span></div>
          {posts.length ? posts.slice(0, 12).map((post) => <PostEntry post={post} />) : <p>New articles from this contributor will appear here.</p>}
        </section>
      </div>
      <aside class="rk-author-sidebar">
        <section class="rk-feature-card">
          <div class="rk-feature-heading"><span>✦</span><div><h2>The {firstName} Files</h2><p>A peek at the interests behind this editorial persona.</p></div></div>
          <div class="rk-feature-art" aria-hidden="true"><span class="rk-sun"></span><span class="rk-mountain rk-mountain-one"></span><span class="rk-mountain rk-mountain-two"></span><span class="rk-trail"></span></div>
          <p class="rk-feature-caption">A little perspective beyond the daily research desk.</p>
          <small>Illustrative editorial personality, not a real-life account.</small>
        </section>
        <section class="rk-transparency-card"><h2>Editorial transparency</h2><p>{a.name} is an AI contributor persona, not a human journalist. The profile's interests are illustrative. Rudra Kasturi Inc. is responsible for publication and editorial standards.</p><a href="/about/">About the publication →</a></section>
      </aside>
    </section>
  </main>
</BaseLayout>
<style>
.rk-author-page{padding:20px 24px 64px}
.rk-author-crumb{display:flex;gap:12px;align-items:center;color:var(--soft);font-size:.9rem;margin:0 0 28px}
.rk-author-crumb a{color:var(--text);text-decoration:none}
.rk-author-hero{display:grid;grid-template-columns:minmax(250px,360px) minmax(0,1fr) minmax(270px,340px);gap:34px;align-items:stretch}
.rk-author-portrait .avatar{width:100%!important;height:auto!important;aspect-ratio:1/1;object-fit:cover;border-radius:20px;background:var(--sky)}
.rk-author-intro{padding:6px 0;display:flex;flex-direction:column;align-items:flex-start}
.rk-eyebrow{font-size:.82rem;font-weight:800;letter-spacing:.05em;color:var(--cobalt);margin-bottom:8px}
.rk-author-intro h1{font-size:clamp(2.7rem,4.3vw,4rem);line-height:1.02;margin:0 0 8px}
.rk-author-role{font-size:1.35rem;color:var(--ink);margin-bottom:16px}
.rk-author-summary{font-size:1rem;line-height:1.55;color:var(--text)}
.rk-author-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;width:100%;margin:26px 0 16px}
.rk-author-stats div{background:var(--tint);border-radius:13px;padding:12px;min-width:0}
.rk-author-stats strong{display:block;color:var(--ink);font-size:.98rem;line-height:1.25;overflow-wrap:anywhere}
.rk-author-stats span{display:block;color:var(--soft);font-size:.78rem;margin-top:3px}
.rk-author-email{display:inline-flex;align-items:center;gap:9px;color:var(--cobalt);font-weight:700;text-decoration:none}
.rk-author-email svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.8}
.rk-publisher{font-size:.82rem;color:var(--soft);margin-top:8px}.rk-publisher a{color:var(--cobalt);font-weight:700;text-decoration:none}
.rk-author-focus{border-left:1px solid var(--line);padding:4px 0 4px 30px}
.rk-author-focus h2{font-size:1.35rem;margin:0 0 14px}
.rk-pills{display:flex;flex-wrap:wrap;gap:8px}.rk-pills span{border-radius:999px;background:var(--tint);padding:7px 13px;font-size:.84rem;color:var(--ink);font-weight:600}
.rk-focus-divider{height:1px;background:var(--line);margin:22px 0 18px}
.rk-author-focus ul{display:grid;gap:11px}.rk-author-focus li{display:flex;gap:12px;align-items:center;font-size:.94rem;color:var(--text)}
.rk-interest-icon{width:22px;flex:0 0 22px;color:var(--ink);font-size:1.2rem;text-align:center}
.rk-persona-note{font-size:.72rem;color:var(--soft);margin-top:14px;line-height:1.4}
.rk-author-body{display:grid;grid-template-columns:minmax(0,1fr) minmax(290px,390px);gap:42px;margin-top:42px;align-items:start}
.rk-about h2,.rk-editorial-focus h2,.rk-latest-work h2{font-size:1.85rem;margin:0 0 16px}
.rk-about p{font-size:1.03rem;line-height:1.62;margin:0 0 12px;color:var(--text)}
.rk-editorial-focus{margin-top:30px}
.rk-focus-cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
.rk-focus-cards article{background:var(--tint);border-radius:13px;padding:16px;min-height:155px}
.rk-focus-symbol{display:block;font-size:1.75rem;line-height:1;color:var(--cobalt);margin-bottom:12px}
.rk-focus-cards h3{font-size:1rem;margin-bottom:7px}.rk-focus-cards p{font-size:.85rem;line-height:1.45;color:var(--text)}
.rk-author-sidebar{display:grid;gap:18px}
.rk-feature-card{background:linear-gradient(145deg,#f4f1ff,#ecebff);border-radius:20px;padding:20px}
.rk-feature-heading{display:flex;gap:12px;align-items:center;margin-bottom:16px}
.rk-feature-heading>span{display:grid;place-items:center;width:48px;height:48px;border-radius:50%;background:#e1e4ff;color:var(--cobalt);font-size:1.6rem;flex:0 0 48px}
.rk-feature-heading h2{font-size:1.35rem;margin-bottom:3px}.rk-feature-heading p{font-size:.9rem;color:var(--text)}
.rk-feature-art{height:190px;position:relative;overflow:hidden;border-radius:13px;background:linear-gradient(180deg,#ffd9ae 0%,#f5c6a2 36%,#b5a3b2 65%,#647b8b 100%)}
.rk-sun{position:absolute;width:42px;height:42px;border-radius:50%;background:#fff0c7;top:28px;left:16%;box-shadow:0 0 35px 15px rgba(255,240,199,.45)}
.rk-mountain{position:absolute;left:-5%;width:115%;height:130px;bottom:-45px;clip-path:polygon(0 100%,20% 28%,34% 66%,53% 8%,73% 65%,88% 22%,100% 100%);background:#536c7b}
.rk-mountain-two{bottom:-64px;left:14%;background:#344e68;transform:scale(1.1)}
.rk-trail{position:absolute;bottom:0;right:20%;width:30%;height:90px;border-radius:100% 0 0 0;border-left:3px solid rgba(255,230,190,.65);transform:rotate(-15deg)}
.rk-feature-caption{text-align:center;font-family:var(--serif);font-style:italic;font-size:1.08rem;color:var(--ink);margin:15px 8px 8px}
.rk-feature-card small{display:block;text-align:center;color:var(--soft);font-size:.7rem}
.rk-transparency-card{border:1px solid var(--line);border-radius:15px;padding:20px}
.rk-transparency-card h2{font-size:1.2rem;margin-bottom:8px}.rk-transparency-card p{font-size:.86rem;line-height:1.5;color:var(--soft);margin-bottom:10px}
.rk-transparency-card a{color:var(--cobalt);font-weight:700;text-decoration:none;font-size:.85rem}
.rk-section-heading{display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin-bottom:12px}
.rk-section-heading span{font-size:.82rem;color:var(--soft)}.rk-latest-work{margin-top:34px}
.rk-latest-work .post-entry{border-top:1px solid var(--line);padding:18px 0}
.rk-latest-work .post-entry h2,.rk-latest-work .post-entry h3{font-size:1.12rem}
@media(max-width:1050px){.rk-author-hero{grid-template-columns:minmax(220px,300px) minmax(0,1fr);gap:26px}.rk-author-focus{grid-column:1/-1;border-left:0;border-top:1px solid var(--line);padding:22px 0 0;display:grid;grid-template-columns:1fr 1fr;column-gap:28px}.rk-author-focus h2:nth-of-type(2),.rk-author-focus ul{grid-column:2}.rk-focus-divider{display:none}.rk-persona-note{grid-column:2}.rk-author-body{grid-template-columns:minmax(0,1fr) 310px;gap:24px}.rk-focus-cards{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:700px){.rk-author-page{padding:14px 20px 48px}.rk-author-crumb{font-size:.8rem;margin-bottom:18px}.rk-author-hero{grid-template-columns:1fr;gap:20px}.rk-author-portrait .avatar{aspect-ratio:1.12/1}.rk-author-intro h1{font-size:2.55rem}.rk-author-role{font-size:1.12rem}.rk-author-stats{margin:18px 0 12px}.rk-author-stats div{padding:10px}.rk-author-stats strong{font-size:.82rem}.rk-author-focus{grid-column:auto;display:block;padding:20px 0 0}.rk-focus-divider{display:block;margin:18px 0}.rk-author-body{grid-template-columns:1fr;gap:24px;margin-top:30px}.rk-about h2,.rk-editorial-focus h2,.rk-latest-work h2{font-size:1.55rem}.rk-about p{font-size:.95rem}.rk-focus-cards{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.rk-focus-cards article{padding:13px;min-height:145px}.rk-feature-art{height:170px}}
@media(max-width:380px){.rk-author-stats,.rk-focus-cards{grid-template-columns:1fr}}
</style>