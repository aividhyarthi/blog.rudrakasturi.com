---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getAllPosts } from '../../lib/posts';

const allPosts = await getAllPosts();
---

<BaseLayout title="Blog | Rudra Kasturi" description="Articles on search, AI and growth by Rudra Kasturi">
  <div class="container">
    <div class="page-header">
      <h1>Blog</h1>
      <p>Practical writing on search, AI and growth strategy.</p>
    </div>
    <div class="posts-grid" style="padding-bottom: 4rem;">
      {allPosts.map((post) => <PostCard post={post} />)}
    </div>
  </div>
</BaseLayout>
