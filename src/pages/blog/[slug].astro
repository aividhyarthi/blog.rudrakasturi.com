---
import { getAllPosts, formatDate, readingTime } from '../../lib/posts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import ConsultingCTA from '../../components/ConsultingCTA.astro';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: {
      post,
      related: posts.filter((p) => p.slug !== post.slug && post.data.tag && p.data.tag === post.data.tag).slice(0, 3),
    },
  }));
}

const { post, related } = Astro.props;
const { Content } = await post.render();
const { title, description, date, updated, tag, image } = post.data;
---

<BaseLayout title={`${title} | Rudra Kasturi`} description={description || undefined}>
  <div class="container">
    <div class="post-header">
      <a href="/blog" class="back-link">&larr; Back to all posts</a>
      <h1>{title}</h1>
      <p class="post-meta">
        By Rudra Kasturi · {formatDate(date)} · {readingTime(post)} min read
        {updated && <span> · Updated {formatDate(updated)}</span>}
      </p>
      {tag && (
        <div class="post-tags">
          <span class="tag">{tag}</span>
        </div>
      )}
    </div>
    {image && <img class="post-hero" src={image} alt="" />}
    <article class="post-content"><Content /></article>

    <ConsultingCTA />

    {related.length > 0 && (
      <section class="related">
        <h2>Keep reading</h2>
        <div class="posts-grid">{related.map((p) => <PostCard post={p} />)}</div>
      </section>
    )}
  </div>
</BaseLayout>
