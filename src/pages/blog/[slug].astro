---
import { getAllPosts, formatDate, readingTime } from '../../lib/posts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostEntry from '../../components/PostEntry.astro';
import ConsultingCTA from '../../components/ConsultingCTA.astro';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: {
      post,
      related: posts.filter((p) => p.slug !== post.slug && post.data.tag && p.data.tag === post.data.tag).slice(0, 3),
    },
  }));
}

const { post, related } = Astro.props;
const { Content } = await post.render();
const { title, description, date, updated, tag, image, type } = post.data;
const label = { article: 'Article', research: 'Research', 'case-study': 'Case study' }[type];
---

<BaseLayout title={`${title} | Rudra Kasturi`} description={description || undefined}>
  <header class="article-head">
    <p class="label">{label}{tag && ` · ${tag}`}</p>
    <h1>{title}</h1>
    <p class="byline">
      By Rudra Kasturi · {formatDate(date)} · {readingTime(post)} min read{updated && ` · Updated ${formatDate(updated)}`}
    </p>
  </header>
  {image && <div class="post-hero"><img src={image} alt="" onerror="this.parentElement.remove()" /></div>}
  <article class="prose"><Content /></article>

  <div class="wrap"><ConsultingCTA /></div>

  {related.length > 0 && (
    <section class="wrap related">
      <h2>Keep reading</h2>
      {related.map((p) => <PostEntry post={p} />)}
    </section>
  )}
</BaseLayout>
