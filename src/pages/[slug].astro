---
// One route at the site root serves both articles and pages, like WordPress did.
import { getCollection } from 'astro:content';
import { getAllPosts, topicOf } from '../lib/posts';
import PostView from '../components/PostView.astro';
import PageView from '../components/PageView.astro';

export async function getStaticPaths() {
  const PLAYBOOK_SLUG = 'the-aeo-and-geo-playbook-technology-content-schema-writing-style-and-myths';
  const posts = await getAllPosts();
  const pages = await getCollection('pages');
  return [
    ...posts.map((post) => ({
      params: { slug: post.slug },
      props: {
        kind: 'post' as const,
        post,
        page: undefined,
        related: posts.filter((p) => p.slug !== post.slug && topicOf(p).slug === topicOf(post).slug).slice(0, 8),
        // The playbook page lists every post marked playbook: true, so new guides need no edit to that page.
        series: post.slug === PLAYBOOK_SLUG ? posts.filter((p) => p.data.playbook) : [],
      },
    })),
    ...pages.map((page) => ({ params: { slug: page.slug }, props: { kind: 'page' as const, page, post: undefined, related: [], series: [] } })),
  ];
}

const { kind, post, page, related, series } = Astro.props;
---

{kind === 'post' ? <PostView post={post!} related={related} series={series} /> : <PageView page={page!} />}
