---
// One route at the site root serves both articles and pages, like WordPress did.
import { getCollection } from 'astro:content';
import { getAllPosts, topicOf } from '../lib/posts';
import PostView from '../components/PostView.astro';
import PageView from '../components/PageView.astro';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  const pages = await getCollection('pages');
  return [
    ...posts.map((post) => ({
      params: { slug: post.slug },
      props: {
        kind: 'post' as const,
        post,
        page: undefined,
        related: posts.filter((p) => p.slug !== post.slug && topicOf(p).slug === topicOf(post).slug).slice(0, 8),
      },
    })),
    ...pages.map((page) => ({ params: { slug: page.slug }, props: { kind: 'page' as const, page, post: undefined, related: [] } })),
  ];
}

const { kind, post, page, related } = Astro.props;
---

{kind === 'post' ? <PostView post={post!} related={related} /> : <PageView page={page!} />}
