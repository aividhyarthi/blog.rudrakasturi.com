---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostEntry from '../components/PostEntry.astro';
import { getAllPosts, getTopics, readingTime, topicOf, sourceLine } from '../lib/posts';
import { SITE, TOOLS, START_HERE, YEARS, mailto } from '../config';

const all = await getAllPosts();
const researched = all.filter((p) => p.data.sources.length > 0);
const featured = researched[0] ?? all[0];
const latest = all.filter((p) => p.slug !== featured.slug).slice(0, 7);
const start = START_HERE.map((slug) => all.find((p) => p.slug === slug)).filter((p) => p !== undefined);
const topics = getTopics(all).filter((t) => t.count >= 3).slice(0, 12);
const featuredVia = sourceLine(featured);
---

<BaseLayout title="Rudra Kasturi | SEO, AEO & AI Search, Explained in Plain English">
  <section class="hero on-blue">
    <div class="wrap hero-grid">
      <div>
        <p class="label">SEO · AEO · AI search · LLMs</p>
        <h1 class="display">Search is being rewritten by AI. Here's what it means, <mark>in plain English.</mark></h1>
        <p class="lede">
          New articles on what Google, ChatGPT and Perplexity are changing, what the experts are arguing about,
          and what you should actually do. Every story links to its original source.
        </p>
        <div class="hero-actions">
          <a class="btn btn-yellow" href="#start">Start here</a>
          <a class="btn btn-ghost" href="/blog">Read the latest</a>
        </div>
      </div>
      <article class="feature">
        <p class="label">Latest explainer · {topicOf(featured).name}</p>
        <h2><a href={`/blog/${featured.slug}/`}>{featured.data.title}</a></h2>
        <p>{featured.data.tldr ?? featured.data.description}</p>
        <p class="entry-meta">{readingTime(featured)} min read{featuredVia && <> · via {featuredVia}</>}</p>
      </article>
    </div>
  </section>

  <div class="sources-strip">
    <div class="wrap">
      <b>We follow:</b>
      <span>Google Search Central</span><span>Search Engine Roundtable</span><span>Search Engine Land</span><span>Search Engine Journal</span><span>and the conversations around them</span>
    </div>
  </div>

  {start.length > 0 && (
    <section class="section" id="start">
      <div class="wrap">
        <div class="section-head">
          <p class="label">New to AEO and AI search?</p>
          <h2>Start with these four</h2>
          <p class="sub">The questions everyone is asking, answered without jargon.</p>
        </div>
        <div class="tiles">
          {start.map((p, i) => (
            <a class={`tile t${i % 4}`} href={`/blog/${p.slug}/`}>
              <small>{topicOf(p).name} · {readingTime(p)} min</small>
              <h3>{p.data.title}</h3>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section section-butter">
    <div class="wrap">
      <div class="section-head">
        <p class="label">Fresh from the field</p>
        <h2>The latest in search and AI</h2>
      </div>
      {latest.map((p) => <PostEntry post={p} />)}
      <p class="more"><a class="link-arrow" href="/blog">All {all.length} articles &rarr;</a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="label">Browse</p>
        <h2>Find it by topic</h2>
      </div>
      <div class="topics">
        {topics.map((t) => <a class="topic" href={`/category/${t.slug}/`}>{t.name} <small>{t.count}</small></a>)}
      </div>
      <p class="more"><a class="link-arrow" href="/category/">All topics &rarr;</a></p>
    </div>
  </section>

  <section class="section section-orange">
    <div class="wrap">
      <div class="section-head">
        <p class="label" style="color: var(--ink)">Free to try</p>
        <h2>Check your own site</h2>
        <p class="sub">Two tools built from the same methods I use with clients.</p>
      </div>
      <div class="cols-2">
        {TOOLS.map((t) => (
          <div class="col">
            <h3>{t.name}</h3>
            <p>{t.blurb}</p>
            <a class="go" href={t.url} rel="noopener">Open {t.name} &rarr;</a>
            <span class="host">{t.host}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="contact">
    <div class="wrap">
      <p class="label">Written by Rudra Kasturi</p>
      <h2>{YEARS} years in search, now explaining where it goes next.</h2>
      <p>I also advise teams on search and AI strategy. If that's useful to you, say hello.</p>
      <a class="btn btn-yellow" href="/about">About Rudra</a>
      <a class="btn btn-ghost" href={mailto}>Email {SITE.email}</a>
    </div>
  </section>
</BaseLayout>
