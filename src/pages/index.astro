---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostEntry from '../components/PostEntry.astro';
import Carousel from '../components/Carousel.astro';
import AuditBanner from '../components/AuditBanner.astro';
import AppRankrSection from '../components/AppRankrSection.astro';
import Subscribe from '../components/Subscribe.astro';
import { getAllPosts, getSections, readingTime, topicOf, mixedLatest, SECTIONS, inSection } from '../lib/posts';
import { SITE, TOOLS, START_HERE, YEARS, NEWSLETTER, mailto } from '../config';

const all = await getAllPosts();
const researched = all.filter((p) => p.data.sources.length > 0);
const featured = researched[0] ?? all[0];
const latest = mixedLatest(all, 8, [featured.slug]);
const rails = SECTIONS.map((sec) => ({ name: sec.name, slug: sec.slug, posts: all.filter((p) => inSection(p, sec)).slice(0, 9) })).filter((r) => r.posts.length >= 3);
const start = START_HERE.map((slug) => all.find((p) => p.slug === slug)).filter((p) => p !== undefined);
const topics = getSections(all);
const origin = new URL(Astro.site!).origin;
const home = [
  {
    '@type': 'Blog', '@id': `${origin}/#blog`, url: `${origin}/blog/`, name: 'Rudra Kasturi: SEO, AEO & AI search, explained',
    publisher: { '@id': `${origin}/#organization` }, author: { '@id': `${origin}/#rudra` }, inLanguage: 'en',
  },
  {
    '@type': 'ItemList', '@id': `${origin}/#latest`, name: 'Latest articles',
    itemListElement: [featured, ...latest].map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: `${origin}/${p.slug}/`, name: p.data.title })),
  },
];
---

<BaseLayout title="Rudra Kasturi | SEO, AEO & AI Search Analysis" description="Clear, sourced analysis of SEO, AEO, AI search, YouTube and Instagram. By Rudra Kasturi: 24+ years in search, ex-Amazon, Yahoo, Times Internet, BYJU's." jsonld={home} mainEntityId={`${origin}/#latest`}>
  <section class="hero on-blue">
    <div class="wrap hero-grid">
      <div>
        <p class="label">SEO · AEO · LLMs · YouTube · Instagram</p>
        <h1 class="display">Search is being rewritten by AI. <mark>What it means for your business.</mark></h1>
        <p class="lede">
          Analysis of what Google, ChatGPT, YouTube and Instagram are changing, what the experts are debating,
          and what to do about it.
        </p>
        <div class="hero-actions">
          <a class="btn btn-mint" href="#start">Start here</a>
          <a class="btn btn-ghost" href="/blog">Read the latest</a>
        </div>
      </div>
      <article class="feature">
        <p class="label">Featured · {topicOf(featured).name}</p>
        <h2><a href={`/${featured.slug}/`}>{featured.data.title}</a></h2>
        <p>{featured.data.tldr ?? featured.data.description}</p>
        <p class="entry-meta">{readingTime(featured)} min read</p>
      </article>
    </div>
  </section>

  {start.length > 0 && (
    <section class="section" id="start">
      <div class="wrap">
        <div class="section-head">
          <p class="label">Start here</p>
          <h2>Start with these four</h2>
          <p class="sub">Essential reading across AI search, YouTube and Instagram.</p>
        </div>
        <div class="tiles">
          {start.map((p, i) => (
            <a class={`tile t${i % 4}`} href={`/${p.slug}/`}>
              <small>{topicOf(p).name} · {readingTime(p)} min</small>
              <h3>{p.data.title}</h3>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section section-tint">
    <div class="wrap">
      <div class="section-head">
        <p class="label">Latest</p>
        <h2>The latest across search, AI and social</h2>
      </div>
      {latest.map((p) => <PostEntry post={p} />)}
      <p class="more"><a class="link-arrow" href="/blog">All {all.length} articles &rarr;</a></p>
    </div>
  </section>

  {rails.map((r, i) => (
    <section class:list={['section', { 'section-sky': i % 2 === 0 }]}>
      <div class="wrap">
        <Carousel label="Topic" title={r.name} href={`/category/${r.slug}/`} posts={r.posts} />
      </div>
    </section>
  ))}

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="label">Browse</p>
        <h2>Find it by topic</h2>
      </div>
      <div class="topics">
        {topics.map((t) => <a class="topic" href={`/category/${t.slug}/`}>{t.name} <small>{t.count}</small></a>)}
      </div>
      <p class="more"><a class="link-arrow" href="/category/">All topics &rarr;</a></p>
    </div>
  </section>

  <div class="wrap" style="padding-top: 24px; padding-bottom: 56px;"><AuditBanner medium="home" /></div>

  <AppRankrSection />

  {NEWSLETTER.enabled && (
    <section class="section section-tint" id="subscribe">
      <div class="wrap"><Subscribe variant="inline" /></div>
    </section>
  )}

  <section class="contact">
    <div class="wrap">
      <p class="label">Written by Rudra Kasturi</p>
      <h2>{YEARS} years in search, now explaining where it goes next.</h2>
      <p>I also advise teams on search and AI strategy. To discuss working together, get in touch.</p>
      <a class="btn btn-mint" href="/about">About Rudra</a>
      <a class="btn btn-ghost" href={mailto}>Email {SITE.email}</a>
    </div>
  </section>
</BaseLayout>
