---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostEntry from '../components/PostEntry.astro';
import Carousel from '../components/Carousel.astro';
import AuditBanner from '../components/AuditBanner.astro';
import AppRankrSection from '../components/AppRankrSection.astro';
import Subscribe from '../components/Subscribe.astro';
import PostCard from '../components/PostCard.astro';
import { APPRANKR_POSTS, utm } from '../config';
import { getTags } from '../lib/posts';
import WelcomeModal from '../components/WelcomeModal.astro';
import { getAllPosts, readingTime, topicOf, topicColor, formatDate, mixedLatest, SECTIONS, inSection } from '../lib/posts';
import { coverUrl } from '../lib/cover';
import { SITE, TOOLS, START_HERE, YEARS, NEWSLETTER, mailto } from '../config';

const all = await getAllPosts();
const researched = all.filter((p) => p.data.sources.length > 0);
const featured = researched[0] ?? all[0];
const mixed = mixedLatest(all, 12, [featured.slug]);
const top = mixed.slice(0, 3); // "Top stories" next to the lead story
const latest = mixed.slice(3);
const appr = TOOLS.find((t) => t.name === 'AppRankr')!;
const tool = TOOLS[0]; // main feed
const rails = SECTIONS.map((sec) => ({ name: sec.name, slug: sec.slug, posts: all.filter((p) => inSection(p, sec)).slice(0, 9) })).filter((r) => r.posts.length >= 3);
const start = START_HERE.map((slug) => all.find((p) => p.slug === slug)).filter((p) => p !== undefined);
const origin = new URL(Astro.site!).origin;
const home = [
  {
    '@type': 'Blog', '@id': `${origin}/#blog`, url: `${origin}/blog/`, name: 'Rudra Kasturi: SEO, AEO & AI search, explained',
    publisher: { '@id': `${origin}/#organization` }, author: { '@id': `${origin}/#rudra` }, inLanguage: 'en',
  },
  {
    '@type': 'ItemList', '@id': `${origin}/#latest`, name: 'Latest articles',
    itemListElement: [featured, ...top, ...latest].map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: `${origin}/${p.slug}/`, name: p.data.title })),
  },
];
---

<BaseLayout title="Rudra Kasturi | SEO, AEO & AI Search Analysis" description="Clear, sourced analysis of SEO, AEO, AI search, YouTube and Instagram. By Rudra Kasturi: 24+ years in search, ex-Amazon, Yahoo, Times Internet, BYJU's." jsonld={home} mainEntityId={`${origin}/#latest`}>
  <h1 class="sr-only">Rudra Kasturi: SEO, AEO and AI search analysis</h1>

  <section class="front">
    <div class="wrap lead-grid">
      <article class={`lead ${topicColor(topicOf(featured).slug)}`}>
        <a class="lead-img" href={`/${featured.slug}/`} tabindex="-1" aria-hidden="true">
          <img src={coverUrl(featured)} alt="" width="1200" height="630" fetchpriority="high" />
        </a>
        <p class="entry-kicker"><a href={`/category/${topicOf(featured).slug}/`}>{topicOf(featured).name}</a><span>{formatDate(featured.data.date)}</span></p>
        <h2><a href={`/${featured.slug}/`}>{featured.data.title}</a></h2>
        <p class="lead-desc">{featured.data.tldr ?? featured.data.description}</p>
        <p class="entry-meta">{readingTime(featured)} min read</p>
      </article>
      <div class="top-stories">
        <h2 class="rail-title">Top stories</h2>
        {top.map((p) => (
          <article class={`top-row ${topicColor(topicOf(p).slug)}`}>
            <a href={`/${p.slug}/`} class="top-thumb" tabindex="-1" aria-hidden="true"><img src={coverUrl(p)} alt="" loading="lazy" width="1200" height="630" /></a>
            <div>
              <p class="entry-kicker"><a href={`/category/${topicOf(p).slug}/`}>{topicOf(p).name}</a><span>{formatDate(p.data.date)}</span></p>
              <h3><a href={`/${p.slug}/`}>{p.data.title}</a></h3>
            </div>
          </article>
        ))}
        <div class="top-row top-appstore">
          <div class="appstore-ico" aria-hidden="true">&#9638;</div>
          <div>
            <p class="entry-kicker"><a href={utm(appr.url, 'home-top')} rel="noopener">App store insights</a><span>AppRankr</span></p>
            <h3><a href={utm(APPRANKR_POSTS[0].url, 'home-top')} rel="noopener">{APPRANKR_POSTS[0].title}</a></h3>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="feed">
    <div class="wrap">
      <div class="section-head">
        <p class="label">Latest</p>
        <h2>The latest across search, AI and social</h2>
      </div>
      <div class="card-grid">
        {latest.map((p) => <PostCard post={p} />)}
      </div>
      <p class="more"><a class="link-arrow" href="/blog/">All {all.length} articles &rarr;</a></p>

      <div class="widget-row">
        <section class="widget">
          <p class="label">App store insights</p>
          <ul>
            {APPRANKR_POSTS.slice(0, 3).map((p) => <li><a href={utm(p.url, 'home-widget')} rel="noopener">{p.title}</a></li>)}
          </ul>
          <a class="link-arrow" href={utm(appr.url, 'home-widget')} rel="noopener">More on AppRankr &rarr;</a>
        </section>
        <section class="widget widget-tool">
          <p class="label">Free tool</p>
          <h3>{tool.name}</h3>
          <p>{tool.blurb}</p>
          <a class="btn" href={utm(tool.url, 'home-widget')} rel="noopener">Try it &rarr;</a>
        </section>
      </div>
    </div>
  </section>

  {start.length > 0 && (
    <section class="section section-tint" id="start">
      <div class="wrap">
        <div class="section-head">
          <p class="label">Start here</p>
          <h2>New to AI search? Start with these four</h2>
        </div>
        <div class="tiles">
          {start.map((p, i) => (
            <a class={`tile t${i % 4}`} href={`/${p.slug}/`}>
              <small>{topicOf(p).name} · {readingTime(p)} min</small>
              <h3>{p.data.title}</h3>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {rails.map((r, i) => (
    <section class:list={['section', { 'section-sky': i % 2 === 0 }]}>
      <div class="wrap">
        <Carousel label="Topic" title={r.name} href={`/category/${r.slug}/`} posts={r.posts} />
      </div>
    </section>
  ))}

  <div class="wrap" style="padding-top: 24px; padding-bottom: 56px;"><AuditBanner medium="home" /></div>

  <AppRankrSection />

  {NEWSLETTER.enabled && (
    <section class="section section-tint" id="subscribe">
      <div class="wrap"><Subscribe variant="inline" /></div>
    </section>
  )}

  <section class="contact">
    <div class="wrap">
      <p class="label">Written by Rudra Kasturi</p>
      <h2>{YEARS} years in search, now explaining where it goes next.</h2>
      <p>I also advise teams on search and AI strategy. To discuss working together, get in touch.</p>
      <a class="btn btn-mint" href="/about">About Rudra</a>
      <a class="btn btn-ghost" href={mailto}>Email {SITE.email}</a>
    </div>
  </section>
  <WelcomeModal />
</BaseLayout>
