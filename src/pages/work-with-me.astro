---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Work With Me | Rudra Kasturi" description="Consulting on search, AI and growth strategy for leadership teams.">
  <div class="container">
    <div class="page-header">
      <h1>Work With Me</h1>
      <p>Advisory for leadership teams who want search, AI and growth to show up in revenue.</p>
    </div>

    <div class="posts-grid">
      <article class="post-card"><h3>Search &amp; AI Visibility</h3><p>Strategy for organic growth in the age of AI answers: SEO, content systems, and getting cited by AI engines.</p></article>
      <article class="post-card"><h3>Growth Strategy</h3><p>Where to invest next. Channel mix, funnels, experimentation, and the metrics that matter to the board.</p></article>
      <article class="post-card"><h3>AI Adoption</h3><p>Practical roadmaps for putting AI to work across marketing, product and operations, without the hype.</p></article>
    </div>

    <aside class="cta-band" style="margin-bottom: 4rem;">
      <div>
        <h3>Let's talk</h3>
        <p>Send a short note on your business and the problem you want solved.</p>
      </div>
      <a href="https://linkedin.com/in/rudrakasturi" target="_blank" rel="noopener" class="btn btn-primary">Message on LinkedIn</a>
    </aside>
  </div>
</BaseLayout>
