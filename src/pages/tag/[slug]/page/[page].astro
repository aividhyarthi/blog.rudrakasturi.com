---
import Listing from '../../../../components/Listing.astro';
import { getAllPosts, getTags, tagOf, pageOf, totalPages } from '../../../../lib/posts';

export async function getStaticPaths() {
  const all = await getAllPosts();
  return getTags(all, 3).flatMap((t) => {
    const posts = all.filter((p) => tagOf(p)?.slug === t.slug);
    const total = totalPages(posts.length);
    return Array.from({ length: total - 1 }, (_, i) => {
      const page = i + 2;
      return { params: { slug: t.slug, page: String(page) }, props: { tag: t, posts: pageOf(posts, page), page, total } };
    });
  });
}
const { tag, posts, page, total } = Astro.props;
---

<Listing
  title={`${tag.name}, page ${page} | Rudra Kasturi`}
  description={`Articles tagged ${tag.name}.`}
  label="Tag"
  heading={tag.name}
  lede={`${tag.count} articles, newest first.`}
  posts={posts}
  current={page}
  total={total}
  base={`/tag/${tag.slug}/`}
/>
